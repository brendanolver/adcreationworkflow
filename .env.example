# --- Database (Railway Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/railway

# --- Server ---
PORT=3333

# --- Meta Marketing API ---
# Create a Meta app (developers.facebook.com) with Marketing API access.
# Phase 1-4: token only needs the ads_read permission.
# Phase 5: add ads_management when that phase actually starts (see README).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
META_API_VERSION=v21.0

# --- ApparelMagic API ---
# Same integration pattern as the scan-to-verify app (aminventory / wholesalescan):
# signed requests to https://{subdomain}.app.apparelmagic.com/api/json/{endpoint}
AM_SUBDOMAIN=
AM_TOKEN=
# Warehouse id(s) to count as sellable/on-hand stock. Comma-separated if more than one.
AM_WAREHOUSE_IDS=1002
